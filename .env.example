# Copy to `.env.local` (ignored by git) and fill in the values you need for
# local development. In production these are injected by the GitHub Pages
# build (set them in repo Settings > Secrets and variables > Actions > Variables).

# Privacy-respecting analytics dashboard (Plausible, Umami, or equivalent).
# Rendered in the Footer under "Analytics". If unset, the link is disabled.
# Example: VITE_ANALYTICS_URL=https://plausible.io/wucsclub.com
VITE_ANALYTICS_URL=
